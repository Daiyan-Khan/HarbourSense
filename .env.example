# HarbourSense local runtime configuration.
# Copy to .env and replace placeholders locally. Never commit live credentials.

# Runtime mode. Use local for Docker Compose Mosquitto; use aws only with explicit IoT values and mounted certs.
MQTT_MODE=local

# MongoDB connection. Replace with a local or Atlas URI in .env.
MONGO_URI=mongodb://host.docker.internal:27017/port
MONGO_DB_NAME=port

# Local Mosquitto settings used by Docker Compose.
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_BROKER_CONTAINER_PORT=1883
MQTT_WEBSOCKET_PORT=9001

# AWS IoT settings for MQTT_MODE=aws. These are placeholders only.
AWS_IOT_ENDPOINT=your-aws-iot-endpoint.amazonaws.com
AWS_IOT_CA_PATH=/app/certs/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=/app/certs/device-certificate.pem.crt
AWS_IOT_KEY_PATH=/app/certs/private.key
