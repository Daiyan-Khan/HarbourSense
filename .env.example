# HarbourSense local runtime configuration.
# Copy to .env and replace placeholders locally. Never commit live credentials.

# Runtime mode. Use local for Docker Compose Mosquitto; use aws only with explicit IoT values and mounted certs.
MQTT_MODE=local

# MongoDB connection. Set MONGO_URI to your target database (Atlas, local Compose mongo, etc.).
# For the Compose local mongo service, use mongodb://mongo:27017/port and set COMPOSE_PROFILES=local-mongo below.
# For Atlas or another external database, set MONGO_URI here and leave COMPOSE_PROFILES unset.
MONGO_URI=mongodb://mongo:27017/port
# Start the local Compose mongo service only when using the local URI above.
COMPOSE_PROFILES=local-mongo
MONGO_DB_NAME=port
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_HOST_PORT=27017
# The explicit mongo-seed Compose profile uses MONGO_URI/MONGO_DB_NAME above.
# Run it only against an intended local/dev database.
# When true, mongo-seed also clears shipments and edgeHistory for a clean smoke run.
SEED_RESET_WORKFLOW=true

# MongoDB time-series retention (TTL indexes applied by mongo-seed on timestamp).
# Documents older than N days are removed automatically by the MongoDB TTL monitor.
MONGO_TTL_SENSOR_DATA_DAYS=7
MONGO_TTL_TRAFFIC_DATA_DAYS=14
MONGO_TTL_EDGE_HISTORY_DAYS=30

# Local Mosquitto settings used by Docker Compose.
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_BROKER_CONTAINER_PORT=1883
MQTT_WEBSOCKET_PORT=9001

# AWS IoT settings for MQTT_MODE=aws. These are placeholders only.
AWS_IOT_ENDPOINT=your-aws-iot-endpoint.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_CA_PATH=/app/certs/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=/app/certs/device-certificate.pem.crt
AWS_IOT_KEY_PATH=/app/certs/private.key

# Port simulator timing (port.js). Comma-separated positive integers in milliseconds.
SHIPMENT_INTERVALS_MS=30000,60000,90000
CRANE_TELEMETRY_INTERVAL_MS=5000
SIM_PROGRESS_INTERVAL_MS=1000
SIM_LOOP_IDLE_DELAY_MS=5000
SIM_LOOP_TICK_MS=1000
SIM_COMPLETING_DELAY_MS=2000
SIM_EDGE_MISSING_DELAY_MS=5000

# Backend log verbosity (python-backend). Use DEBUG for [WF] workflow correlation lines.
BACKEND_LOG_LEVEL=INFO
SIM_TASK_STEP_MS=2000

# Dev workflow speed (higher multiplier / lower distance scale = faster movement)
SIM_SPEED_MULTIPLIER=5
SIM_NODE_DISTANCE_SCALE=20

# Port simulator structured debug (port-sim). Master switch plus optional component flags.
# Component flags fall back to SIM_DEBUG when unset.
# Enable SIM_DEBUG_LOOP=true and SIM_DEBUG_MQTT=true to trace edge phase transitions and task ingress during workflow debugging.
SIM_DEBUG=false
SIM_DEBUG_LOOP=false
SIM_DEBUG_MQTT=false
SIM_DEBUG_CHAIN=false
SIM_LOG_TO_FILE=false
